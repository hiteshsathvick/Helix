# Copy to .env and adjust as needed. Never commit the real .env file.

ENVIRONMENT=local

# --- Postgres ---
# POSTGRES_USER is a superuser (Postgres bootstrap requirement) — used only
# for running migrations, never by the running app (superusers bypass Row-
# Level Security, which would silently defeat tenant isolation). The app
# connects as helix_app, a low-privilege role created by
# infra/docker/postgres-init/01-app-role.sql on first container init.
POSTGRES_USER=helix
POSTGRES_PASSWORD=helix
POSTGRES_DB=helix
DATABASE_URL=postgresql+asyncpg://helix_app:helix_app@postgres:5432/helix
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://helix:helix@postgres:5432/helix

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth (Phase 3) ---
# JWT_SIGNING_KEYS must be valid JSON: {"kid": "secret", ...}. Generate real
# secrets per environment — never reuse the local-dev default outside local
# dev. JWT_ACTIVE_KID selects which key signs *new* tokens; old keys can stay
# listed so tokens signed under them still verify until they expire.
# Phase 19: the app now refuses to start with this (or CONNECTOR_ENCRYPTION_KEY
# below) left at its local-dev default whenever ENVIRONMENT != local — see
# app/core/secrets_guard.py.
JWT_SIGNING_KEYS={"local-dev-key-1": "change-me-in-every-real-environment"}
JWT_ACTIVE_KID=local-dev-key-1
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=helix
MINIO_ROOT_PASSWORD=helix-secret
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=helix
S3_SECRET_KEY=helix-secret
S3_BUCKET=helix

# --- AI provider abstraction (Phase 11) ---
# AI_DEFAULT_PROVIDER selects which of the providers below an org uses when
# it hasn't set its own via PUT /orgs/{id}/ai-config. Get an Anthropic key
# at https://console.anthropic.com/settings/keys — never commit real values.
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only needed if an org's ai-config selects the "ollama" provider — points
# at a local Ollama server's OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- Agent runtime (Phase 12) ---
# Default-deny (SPEC.md §29): must be valid JSON, e.g. ["api.example.com"].
# Empty means the http_request tool refuses every host.
AGENT_HTTP_ALLOWLIST=[]

# --- Connectors (Phase 14) ---
# Must be a valid Fernet key: python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())" — never reuse the
# local-dev default outside local dev, same warning as JWT_SIGNING_KEYS.
CONNECTOR_ENCRYPTION_KEY=THs3h55oNt0505SRw1YgPLKE0TlCB_fkSaxjfmg51GM=
# Only needed to actually connect the GitHub connector — register a free
# OAuth App at https://github.com/settings/developers (callback URL must
# match GITHUB_OAUTH_REDIRECT_URL below). The connector's code and tests
# never require this; it's only needed for a live connect.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/oauth/github/callback
CONNECTOR_SYNC_INTERVAL_MINUTES=15
# Default-deny (SPEC.md §29), same posture as AGENT_HTTP_ALLOWLIST but a
# deliberately separate setting — see connectors/web.py's module docstring.
CONNECTOR_WEB_ALLOWLIST=[]

# --- Notifications (Phase 15) ---
# Defaults point at the local Mailpit dev-catcher (docker-compose.yml) —
# no account or cost needed for local dev/testing. View sent mail at
# http://localhost:8025. Point these at a real provider's SMTP relay
# (SendGrid/Postmark/SES/Resend all expose one) for a live deployment;
# no code change required.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_ADDRESS=notifications@helix.local
NOTIFICATION_MAX_JOB_ATTEMPTS=3
# UTC hour the daily digest sweep runs at.
NOTIFICATION_DIGEST_HOUR=9

# --- Billing (Phase 16) ---
# Test-mode Stripe keys are free -- create a Stripe account, stay in test
# mode, and use its sk_test_... secret key. STRIPE_WEBHOOK_SECRET comes
# from `stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe`
# for local dev, or the dashboard's webhook config for a deployed
# environment. Price IDs are only needed to actually create a Checkout
# Session for that plan (create a flat-rate recurring Price per plan in
# the Stripe dashboard, test mode) -- the free plan needs neither.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Also the backend's sole allowed CORS origin (app/main.py) and the GitHub
# OAuth callback's redirect target — keep it matching wherever the frontend
# actually runs.
FRONTEND_URL=http://localhost:3000
