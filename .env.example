# Copy to .env and adjust as needed. Never commit the real .env file.

ENVIRONMENT=local

# --- Postgres ---
POSTGRES_USER=helix
POSTGRES_PASSWORD=helix
POSTGRES_DB=helix
DATABASE_URL=postgresql+asyncpg://helix:helix@postgres:5432/helix

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=helix
MINIO_ROOT_PASSWORD=helix-secret
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=helix
S3_SECRET_KEY=helix-secret
S3_BUCKET=helix

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
